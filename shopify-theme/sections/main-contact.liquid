<section class="contact-page"><div class="section-heading"><p class="eyebrow">Customer care</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.copy }}</p></div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="form-success">Thanks. We'll get back to you soon.</p>{% endif %}{% if form.errors %}<p class="form-error">Please review the fields below.</p>{% endif %}<label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" required><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" required><label for="ContactOrder">Order number, if you have one</label><input id="ContactOrder" type="text" name="contact[order_number]"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" rows="7" required></textarea><button class="button" type="submit">Send message</button>{% endform %}</section>
{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"heading","label":"Heading","default":"We're here to help."},{"type":"textarea","id":"copy","label":"Copy","default":"For an existing order, include your order number so we can help faster."}]}{% endschema %}
