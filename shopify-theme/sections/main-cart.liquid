<section class="product-page"><div class="section-heading"><p class="eyebrow">Your selection</p><h1>Bag</h1></div>{% if cart.item_count == 0 %}<p>Your bag is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore objects</a>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="feature"><span class="feature-number">{{ forloop.index | prepend: '0' }}</span><h3>{{ item.product.title }}<br>{{ item.final_line_price | money }}</h3><p><a href="{{ item.url }}">View product</a> · <a href="{{ item.url_to_remove }}">Remove</a></p></div>{% endfor %}<div class="purchase-panel"><div><p class="eyebrow">Subtotal</p><h2>{{ cart.total_price | money }}</h2></div><button class="button" type="submit" name="checkout">Checkout</button></div>{% endform %}{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
