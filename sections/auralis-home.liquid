{% assign featured_product = section.settings.product %}
{% assign hero_image = blank %}

<section class="auralis-hero" data-product-stage>
  <div class="auralis-hero__copy" data-reveal>
    <p class="auralis-kicker">Portable countertop extraction</p>
    <h1>Keep smoke <span>closer to <em>the source.</em></span></h1>
    <p class="auralis-hero__intro">A compact, plug-in extractor that draws cooking smoke toward its black front intake, right beside the pan.</p>
    <div class="auralis-actions"><a class="auralis-button" href="#shop">Shop the extractor <span aria-hidden="true">-></span></a><a class="auralis-text-link" href="#intake">See how it works</a></div>
  </div>
  <div class="auralis-stage" aria-label="Portable countertop extractor" data-stage-visual>
    <div class="auralis-stage__halo"></div><div class="auralis-stage__orbit auralis-stage__orbit--one"></div><div class="auralis-stage__orbit auralis-stage__orbit--two"></div>
    <div class="auralis-product-3d" data-product-object><div class="auralis-product-3d__shadow"></div><div class="auralis-product-3d__back"></div><div class="auralis-product-3d__face">{% if hero_image != blank %}{{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '520, 760, 1000, 1400', alt: section.settings.product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ section.settings.product_alt | escape }}" width="800" height="800" loading="eager">{% endif %}</div></div>
  </div>
  <div class="auralis-hero__foot"><span>USB-C powered</span><span>Three mechanical speeds</span><span>Use alongside kitchen ventilation</span></div>
</section>

<section class="auralis-intake" id="intake" data-intake-section>
  <div class="auralis-intake__lead"><p class="auralis-kicker">The intake is the <strong>point</strong></p><h2>It pulls <em>in.</em><br>It does not blow out.</h2></div>
  <div class="auralis-intake__scene"><figure class="auralis-intake__image"><img src="{{ 'auralis-extractor-cooking.jpg' | asset_url }}" alt="The extractor beside a pan, facing cooking smoke" width="800" height="800" loading="lazy"></figure><div class="auralis-intake__notes"><p><span>01</span> Set it beside the source</p><p><span>02</span> Aim the black grille at the smoke</p><p><span>03</span> Use it alongside normal kitchen ventilation</p></div></div>
</section>

<section class="auralis-object-grid">
  <div class="auralis-object-grid__title"><p class="auralis-kicker">One object, close up</p><h2>Made to stay<br>on the counter.</h2></div>
  <figure class="auralis-object-card auralis-object-card--large"><img src="{{ 'auralis-extractor-detail.jpg' | asset_url }}" alt="Close-up of the portable extractor body" width="800" height="800" loading="lazy"><figcaption>Small footprint, considered form.</figcaption></figure>
  <figure class="auralis-object-card"><img src="{{ 'auralis-extractor-filter.jpg' | asset_url }}" alt="Front intake filter detail" width="800" height="800" loading="lazy"><figcaption>The front is the intake.</figcaption></figure>
  <div class="auralis-object-grid__statement"><p>Portable when the cooking happens beyond the built-in hood.</p><span>Not a replacement for a range hood.</span></div>
</section>

<section class="auralis-shop" id="shop">
  <div class="auralis-shop__intro"><p class="auralis-kicker">Choose your finish</p><h2>Bring the intake closer to the moment.</h2><p>Choose your finish below. The option you select controls the live price, availability and primary product image.</p></div>
  <div class="auralis-purchase" data-purchase-panel>
    {% if featured_product != blank %}
      {% assign selected_variant = featured_product.selected_or_first_available_variant %}{% assign initial_media = selected_variant.featured_media | default: featured_product.featured_media %}
      <div class="auralis-gallery" data-product-gallery><div class="auralis-gallery__thumbs" aria-label="Product gallery">{% for media in featured_product.media %}{% if media.media_type == 'image' %}<button class="auralis-gallery__thumb{% if media.id == initial_media.id %} is-active{% endif %}" type="button" data-gallery-thumb data-media-id="{{ media.id }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if media.id == initial_media.id %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', alt: media.alt | default: featured_product.title }}</button>{% endif %}{% endfor %}</div><div class="auralis-gallery__viewport" aria-live="polite">{% for media in featured_product.media %}{% if media.media_type == 'image' %}<figure class="auralis-gallery__slide{% if media.id == initial_media.id %} is-active{% endif %}" data-gallery-slide data-media-id="{{ media.id }}"{% unless media.id == initial_media.id %} hidden{% endunless %}>{{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '520, 760, 1040, 1400', alt: media.alt | default: featured_product.title }}</figure>{% endif %}{% endfor %}</div><p class="auralis-gallery__hint">Use the thumbnails to inspect the exact product, filter and finish details.</p></div>
      <div class="auralis-purchase__form"><p class="auralis-kicker">{{ featured_product.vendor | default: 'Monovere' }}</p><h3>{{ featured_product.title }}</h3><p class="auralis-price" data-variant-price>{{ selected_variant.price | money }}</p><p class="auralis-purchase__summary">USB-C powered / 3 speeds / 180 x 108 x 420 mm</p>{% form 'product', featured_product, class: 'auralis-form', id: 'home-product-form' %}{% unless featured_product.has_only_default_variant %}<fieldset class="auralis-colours"><legend>Finish <span data-selected-colour>{{ selected_variant.title }}</span></legend><div>{% for variant in featured_product.variants %}<button class="auralis-colour{% if variant.id == selected_variant.id %} is-active{% endif %}" type="button" data-variant-picker data-variant-id="{{ variant.id }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" aria-pressed="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>{% endfor %}</div></fieldset><select class="auralis-native-variant" id="home-variant" name="id" aria-label="Finish">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" {% if variant.id == selected_variant.id %}selected{% endif %}{% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ selected_variant.id }}">{% endunless %}<div class="auralis-form__row"><label for="home-quantity">Quantity<input id="home-quantity" name="quantity" type="number" min="1" value="1" inputmode="numeric" autocomplete="off"></label><button class="auralis-button" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>Add to bag <span aria-hidden="true">-></span></button></div>{% if section.settings.show_dynamic_checkout %}<div class="auralis-dynamic-checkout">{{ form | payment_button }}</div>{% endif %}{% endform %}<p class="auralis-purchase__note">Requires continuous power while in use. Shipping options and enabled payment methods are shown securely at checkout.</p></div>
    {% else %}
      <div class="auralis-purchase__media"><img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="Portable countertop extractor" width="800" height="800" loading="lazy"></div><div class="auralis-purchase__form"><p class="auralis-price">Choose the product in the Shopify theme editor to activate the real price, options and checkout.</p></div>
    {% endif %}
  </div>
</section>

<section class="auralis-specs" aria-labelledby="auralis-specs-title"><div><p class="auralis-kicker">What you are getting</p><h2 id="auralis-specs-title">Straightforward details, before checkout.</h2></div><div class="auralis-specs__grid"><article><strong>USB-C powered</strong><span>Stays connected to power while in use.</span></article><article><strong>3 mechanical speeds</strong><span>Simple physical controls for everyday cooking.</span></article><article><strong>Close-range format</strong><span>Place the black intake beside the source.</span></article><article><strong>In the box</strong><span>Extractor, tripod, filter, USB-C cable and instructions.</span></article></div></section>

<section class="auralis-answers"><div><p class="auralis-kicker">Before you order</p><h2>Everything should be clear before checkout.</h2></div><div class="auralis-answers__list"><details open><summary>Does it blow air toward the pan?<span>+</span></summary><p>No. The black front grille is the intake. It is intended to draw cooking smoke toward the device.</p></details><details><summary>Does it replace a range hood?<span>+</span></summary><p>No. It is a portable close-range extractor. Use it alongside normal kitchen ventilation.</p></details><details><summary>What arrives in the box?<span>+</span></summary><p>One extractor, tripod, filter screen, USB-C cable and instruction manual. The selected finish controls the exact variant in your bag.</p></details><details><summary>Does it need to stay plugged in?<span>+</span></summary><p>Yes. This model requires continuous USB-C power while it is in use.</p></details><details><summary>How do delivery and payment work?<span>+</span></summary><p>Shipping options and any payment methods enabled for this store are calculated and confirmed securely at checkout.</p></details></div></section>

<section class="auralis-final"><p class="auralis-kicker">Monovere</p><h2>Give cooking<br>some room.</h2><a class="auralis-button auralis-button--paper" href="#shop">Shop the extractor <span aria-hidden="true">-></span></a></section>

{% schema %}
{"name":"Monovere immersive home","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"product_alt","label":"Product image alt text","default":"Portable countertop extractor"},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout buttons","default":true}],"presets":[{"name":"Monovere immersive home"}]}
{% endschema %}
