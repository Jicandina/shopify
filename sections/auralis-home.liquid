{% assign featured_product = section.settings.product %}
{% assign hero_image = section.settings.hero_image | default: featured_product.featured_image %}

<section class="hero hero--product">
  <div class="hero-copy fade-up">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero-text">{{ section.settings.description }}</p>
    <div class="hero-actions">
      <a class="button" href="#buy">{{ section.settings.primary_label }}</a>
      <a class="button button--quiet" href="#how-it-works">{{ section.settings.secondary_label }}</a>
    </div>
    {% if featured_product != blank %}<div class="hero-purchase-note"><span>{{ featured_product.price | money }}</span><span>Available in {{ featured_product.variants.size }} option{% if featured_product.variants.size != 1 %}s{% endif %}</span></div>{% endif %}
  </div>
  <div class="hero-object fade-up" style="transition-delay:.12s">
    <div class="orbit"></div><span class="orbital-label">Countertop air, close by</span>
    <div class="product-tilt" data-tilt>
      {% if hero_image != blank %}{{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '520, 760, 1000, 1400', alt: section.settings.product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ section.settings.product_alt | escape }}" loading="eager">{% endif %}
    </div>
  </div>
</section>

<section class="proof-strip" aria-label="Product highlights">
  <span>{{ section.settings.highlight_one }}</span><span>{{ section.settings.highlight_two }}</span><span>{{ section.settings.highlight_three }}</span>
</section>

<section class="buy-section" id="buy">
  <div class="buy-gallery fade-up">
    {% if featured_product != blank and featured_product.media.size > 0 %}
      {% for media in featured_product.media limit: 4 %}{% if media.media_type == 'image' %}<figure class="buy-gallery__item {% if forloop.first %}buy-gallery__item--large{% endif %}">{{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 760, 1200', alt: media.alt }}</figure>{% endif %}{% endfor %}
    {% else %}
      <figure class="buy-gallery__item buy-gallery__item--large"><img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="Portable countertop extractor" loading="lazy"></figure>
      <figure class="buy-gallery__item"><img src="{{ 'auralis-extractor-cooking.jpg' | asset_url }}" alt="Extractor placed next to a pan" loading="lazy"></figure>
      <figure class="buy-gallery__item"><img src="{{ 'auralis-extractor-detail.jpg' | asset_url }}" alt="Product detail" loading="lazy"></figure>
    {% endif %}
  </div>
  <aside class="buy-panel fade-up" style="transition-delay:.08s">
    <p class="eyebrow">The first Auralis object</p>
    <h2>{% if featured_product != blank %}{{ featured_product.title }}{% else %}Portable countertop extractor{% endif %}</h2>
    {% if featured_product != blank %}
      <p class="buy-price">{{ featured_product.price | money }}</p>
      {% form 'product', featured_product, class: 'buy-form', id: 'home-product-form' %}
        {% unless featured_product.has_only_default_variant %}<label for="home-variant">Choose your option</label><select id="home-variant" name="id">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">{% endunless %}
        <label for="home-quantity">Quantity</label><div class="quantity-row"><input id="home-quantity" name="quantity" type="number" min="1" value="1"><button class="button" type="submit" {% unless featured_product.available %}disabled{% endunless %}>{% if featured_product.available %}Add to bag{% else %}Sold out{% endif %}</button></div>
        {% if section.settings.show_dynamic_checkout %}<div class="dynamic-payment">{{ form | payment_button }}</div>{% endif %}
      {% endform %}
      <p class="purchase-helper">Secure checkout is handled by Shopify. Payment choices appear when enabled for the store.</p>
    {% else %}
      <p class="buy-price">Choose this product in the Shopify theme editor to activate price, options, and checkout.</p><a class="button" href="{{ routes.all_products_collection_url }}">View product</a>
    {% endif %}
  </aside>
</section>

<section class="section how-section" id="how-it-works">
  <div class="section-heading fade-up"><p class="eyebrow">What it is</p><h2>Bring the intake closer to the moment.</h2><p>{{ section.settings.how_copy }}</p></div>
  <div class="how-grid">
    <article class="how-step fade-up"><span>01</span><h3>Place it nearby</h3><p>Set the compact extractor beside the cooking area, where smoke and aroma begin.</p></article>
    <article class="how-step fade-up" style="transition-delay:.08s"><span>02</span><h3>Face the front intake</h3><p>The front filter is the intake. It is designed to pull air toward the appliance, not blow it back at the pan.</p></article>
    <article class="how-step fade-up" style="transition-delay:.16s"><span>03</span><h3>Make cleanup simpler</h3><p>Use this space to publish verified care and replacement-filter guidance from your final supplier listing.</p></article>
  </div>
</section>

<section class="spec-section">
  <div class="spec-image"><img src="{{ 'auralis-extractor-filter.jpg' | asset_url }}" alt="Front filter and product construction" loading="lazy"></div>
  <div class="spec-content"><p class="eyebrow">At a glance</p><h2>Details, without the guesswork.</h2><div class="spec-list">
    {% for block in section.blocks %}{% if block.type == 'spec' %}<div class="spec-row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><strong>{{ block.settings.value }}</strong></div>{% endif %}{% endfor %}
  </div><p class="spec-disclaimer">Confirm final dimensions, runtime, contents, and shipping promise against the CJ product variant before publishing.</p></div>
</section>

<section class="section support-section">
  <div class="section-heading fade-up"><p class="eyebrow">Before you order</p><h2>Clear answers, up front.</h2></div>
  <div class="faq-list fade-up">
    {% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span aria-hidden="true">+</span></summary><div class="faq-answer">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}
  </div>
</section>

<section class="closing-cta"><div><p class="eyebrow">Auralis, first release</p><h2>Cooking leaves enough behind. Keep the air closer.</h2></div><a class="button button--light" href="#buy">Choose yours</a></section>

