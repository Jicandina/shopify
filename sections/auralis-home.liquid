{% assign featured_product = section.settings.product %}
{% assign hero_image = section.settings.hero_image | default: featured_product.featured_image %}

<section class="auralis-hero" data-product-stage>
  <div class="auralis-hero__copy" data-reveal>
    <p class="auralis-kicker">Auralis presents</p>
    <h1>Clear the air<br>around <em>the pan.</em></h1>
    <p class="auralis-hero__intro">A portable countertop extractor that draws cooking smoke toward its front intake, right where it starts.</p>
    <div class="auralis-actions"><a class="auralis-button" href="#shop">Shop the extractor <span aria-hidden="true">↘</span></a><a class="auralis-text-link" href="#intake">See how it works</a></div>
  </div>
  <div class="auralis-stage" aria-label="Interactive product view" data-stage-visual>
    <div class="auralis-stage__halo"></div><div class="auralis-stage__orbit auralis-stage__orbit--one"></div><div class="auralis-stage__orbit auralis-stage__orbit--two"></div>
    <p class="auralis-stage__label">Portable extraction<br>for the countertop</p>
    <div class="auralis-product-3d" data-product-object>
      <div class="auralis-product-3d__shadow"></div>
      <div class="auralis-product-3d__back"></div>
      <div class="auralis-product-3d__face">{% if hero_image != blank %}{{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '520, 760, 1000, 1400', alt: section.settings.product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ section.settings.product_alt | escape }}" loading="eager">{% endif %}</div>
    </div>
    <p class="auralis-stage__hint">Move to explore</p>
  </div>
  <div class="auralis-hero__foot"><span>Front-facing intake</span><span>Countertop format</span><span>Designed for close-range cooking</span></div>
</section>

<section class="auralis-intake" id="intake" data-intake-section>
  <div class="auralis-intake__lead"><p class="auralis-kicker">The intake is the point</p><h2>It pulls <em>in.</em><br>It does not blow out.</h2></div>
  <div class="auralis-intake__scene">
    <figure class="auralis-intake__image"><img src="{{ 'auralis-extractor-cooking.jpg' | asset_url }}" alt="The extractor beside a pan, facing cooking smoke" loading="lazy"></figure>
    <div class="auralis-air-path" aria-hidden="true"><i></i><i></i><i></i><b>Smoke moves toward the black front grille</b></div>
    <div class="auralis-intake__notes"><p><span>01</span> Set it beside the source</p><p><span>02</span> Aim the black grille at the smoke</p><p><span>03</span> Use it alongside normal kitchen ventilation</p></div>
  </div>
</section>

<section class="auralis-object-grid">
  <div class="auralis-object-grid__title"><p class="auralis-kicker">One object, close up</p><h2>Made to stay<br>on the counter.</h2></div>
  <figure class="auralis-object-card auralis-object-card--large"><img src="{{ 'auralis-extractor-detail.jpg' | asset_url }}" alt="Close-up of the portable extractor body" loading="lazy"><figcaption>Small footprint, considered form.</figcaption></figure>
  <figure class="auralis-object-card"><img src="{{ 'auralis-extractor-filter.jpg' | asset_url }}" alt="Front intake filter detail" loading="lazy"><figcaption>The front is the intake.</figcaption></figure>
  <div class="auralis-object-grid__statement"><p>Portable when the cooking happens beyond the built-in hood.</p><span>Not a replacement for a range hood.</span></div>
</section>

<section class="auralis-shop" id="shop">
  <div class="auralis-shop__intro"><p class="auralis-kicker">The first Auralis object</p><h2>Ready to make room for.</h2><p>Choose the verified product option below. Final price, included contents and availability come directly from your Shopify product.</p></div>
  <div class="auralis-purchase" data-purchase-panel>
    <div class="auralis-purchase__media">{% if featured_product != blank and featured_product.featured_image != blank %}{{ featured_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 760, 1200', alt: featured_product.title }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="Portable countertop extractor" loading="lazy">{% endif %}</div>
    <div class="auralis-purchase__form"><p class="auralis-kicker">{{ featured_product.vendor | default: 'Auralis' }}</p><h3>{% if featured_product != blank %}{{ featured_product.title }}{% else %}Portable countertop extractor{% endif %}</h3>{% if featured_product != blank %}<p class="auralis-price">{{ featured_product.price | money }}</p>{% form 'product', featured_product, class: 'auralis-form', id: 'home-product-form' %}{% unless featured_product.has_only_default_variant %}<label for="home-variant">Choose your option</label><select id="home-variant" name="id">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">{% endunless %}<div class="auralis-form__row"><label for="home-quantity">Qty<input id="home-quantity" name="quantity" type="number" min="1" value="1"></label><button class="auralis-button" type="submit" {% unless featured_product.available %}disabled{% endunless %}>{% if featured_product.available %}Add to bag <span aria-hidden="true">↗</span>{% else %}Sold out{% endif %}</button></div>{% if section.settings.show_dynamic_checkout %}<div class="auralis-dynamic-checkout">{{ form | payment_button }}</div>{% endif %}{% endform %}<p class="auralis-purchase__note">Secure checkout is handled by Shopify. Payment methods appear when they are activated for this store.</p>{% else %}<p class="auralis-price">Choose the product in the Shopify theme editor to activate the real price, options and checkout.</p>{% endif %}</div>
  </div>
</section>

<section class="auralis-answers">
  <div><p class="auralis-kicker">Before you order</p><h2>Everything should be clear before checkout.</h2></div>
  <div class="auralis-answers__list"><details open><summary>Does it blow air toward the pan?<span>+</span></summary><p>No. The black front grille is the intake. The intended airflow moves from the pan and smoke toward the device.</p></details><details><summary>Does it replace a range hood?<span>+</span></summary><p>No. It is a portable close-range extractor. Use it alongside normal kitchen ventilation.</p></details><details><summary>What arrives in the box?<span>+</span></summary><p>Use the selected Shopify variant as the source of truth for contents, dimensions and included accessories.</p></details><details><summary>How do payment and delivery work?<span>+</span></summary><p>Shopify displays enabled payment methods at checkout. Publish delivery and return terms only after confirming the supplier variant.</p></details></div>
</section>

<section class="auralis-final"><p class="auralis-kicker">Auralis</p><h2>Give cooking<br>some room.</h2><a class="auralis-button auralis-button--paper" href="#shop">Shop the extractor <span aria-hidden="true">↘</span></a></section>

{% schema %}
{"name":"Auralis immersive home","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"product_alt","label":"Product image alt text","default":"Portable countertop extractor"},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout buttons","default":true}],"presets":[{"name":"Auralis immersive home"}]}
{% endschema %}
