{% assign featured_product = section.settings.product %}
{% assign hero_image = section.settings.hero_image | default: featured_product.featured_image %}

<section class="hero">
  <div class="hero-copy fade-up">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero-text">{{ section.settings.description }}</p>
    <div class="hero-actions">
      {% if featured_product != blank %}<a class="button" href="{{ featured_product.url }}">{{ section.settings.primary_label }}</a>{% endif %}
      <a class="button button--quiet" href="#details">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
  <div class="hero-object fade-up" style="transition-delay:.12s">
    <div class="orbit"></div><span class="orbital-label">Countertop object, 01</span>
    <div class="product-tilt" data-tilt>
      {% if hero_image != blank %}{{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '520, 760, 1000, 1400', alt: section.settings.product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ section.settings.product_alt | escape }}" loading="eager">{% endif %}
    </div>
  </div>
  <span class="scroll-cue">Scroll to inspect</span>
</section>

<section class="section" id="details">
  <div class="section-heading fade-up"><p class="eyebrow">The daily ritual</p><h2>{{ section.settings.story_heading }}</h2><p>{{ section.settings.story_copy }}</p></div>
  <div class="story-grid">
    <div class="fade-up"><div class="story-image">{% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.story_image.alt }}{% else %}<img src="{{ 'auralis-extractor-cooking.jpg' | asset_url }}" alt="Portable extractor beside a stovetop" loading="lazy">{% endif %}</div><p class="story-caption">A smaller footprint for the countertop.</p></div>
    <div class="feature-stack fade-up" style="transition-delay:.1s">
      {% for block in section.blocks %}<article class="feature" {{ block.shopify_attributes }}><span class="feature-number">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}
    </div>
  </div>
</section>

<section class="detail-grid">
  <div class="detail-grid__copy fade-up"><p class="eyebrow">Built to be seen</p><h2>{{ section.settings.detail_heading }}</h2><p>{{ section.settings.detail_copy }}</p></div>
  <div class="detail-grid__image">{% if section.settings.detail_image != blank %}{{ section.settings.detail_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.detail_image.alt }}{% else %}<img src="{{ 'auralis-extractor-detail.jpg' | asset_url }}" alt="Portable extractor details" loading="lazy">{% endif %}</div>
</section>

<section class="purchase-panel fade-up">
  <div><p class="eyebrow">{{ section.settings.purchase_eyebrow }}</p><h2>{{ section.settings.purchase_heading }}</h2></div>
  {% if featured_product != blank %}
    {% form 'product', featured_product, class: 'product-form' %}
      <span class="product-price">{{ featured_product.price | money }}</span>
      {% unless featured_product.has_only_default_variant %}<label class="visually-hidden" for="home-variant">Variant</label><select id="home-variant" name="id">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} · {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">{% endunless %}
      <button class="button" type="submit" {% unless featured_product.available %}disabled{% endunless %}>{% if featured_product.available %}{{ section.settings.purchase_label }}{% else %}Sold out{% endif %}</button>
    {% endform %}
  {% else %}<a class="button" href="{{ routes.all_products_collection_url }}">{{ section.settings.purchase_label }}</a>{% endif %}
</section>

