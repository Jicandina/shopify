{% assign product_alt = product.featured_image.alt | default: product.title %}
<section class="product-page product-page--full">
  <div class="product-layout product-layout--gallery">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__main" data-gallery-main>
        {% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', alt: product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ product.title | escape }}">{% endif %}
      </div>
      {% if product.media.size > 1 %}<div class="product-gallery__thumbs">{% for media in product.media limit: 6 %}{% if media.media_type == 'image' %}<button type="button" class="gallery-thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb data-full-image="{{ media.preview_image | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</button>{% endif %}{% endfor %}</div>{% endif %}
    </div>
    <div class="product-copy product-copy--purchase"><span class="badge">Auralis first release</span><h1>{{ product.title }}</h1><p class="product-price product-price--large">{{ product.price | money }}</p><div class="rte">{{ product.description }}</div>
      {% form 'product', product, class: 'product-form product-form--full', id: 'product-form' %}
        {% unless product.has_only_default_variant %}<label for="product-variant">Choose your option</label><select id="product-variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
        <label for="product-quantity">Quantity</label><div class="quantity-row"><input id="product-quantity" name="quantity" type="number" min="1" value="1"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button></div>
        {% if section.settings.show_dynamic_checkout %}<div class="dynamic-payment">{{ form | payment_button }}</div>{% endif %}
      {% endform %}
      <div class="purchase-notes"><span>Secure checkout by Shopify</span><span>Delivery estimate appears at checkout</span></div>
    </div>
  </div>
</section>

<section class="product-accordions section">
  <div class="section-heading"><p class="eyebrow">Product information</p><h2>Everything you should know first.</h2></div>
  <div class="faq-list">{% for block in section.blocks %}<details {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}><summary>{{ block.settings.heading }}<span aria-hidden="true">+</span></summary><div class="faq-answer">{{ block.settings.content }}</div></details>{% endfor %}</div>
</section>

{% schema %}
{"name":"Main product","settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout buttons","default":true}],"blocks":[{"type":"detail","name":"Product detail","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shipping and delivery"},{"type":"textarea","id":"content","label":"Content","default":"The delivery estimate is shown at checkout for the chosen product variant and destination."}]}],"max_blocks":5,"presets":[{"name":"Main product","blocks":[{"type":"detail","settings":{"heading":"Shipping and delivery","content":"The expected delivery window is calculated at checkout for your address and selected variant."}},{"type":"detail","settings":{"heading":"Returns","content":"Add your published return policy here before opening the store to customers."}},{"type":"detail","settings":{"heading":"Product care","content":"Publish only care instructions that match the final CJ product variant."}}]}]}
{% endschema %}
