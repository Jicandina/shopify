{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign initial_media = selected_variant.featured_media | default: product.featured_media %}
{% assign product_alt = initial_media.alt | default: product.title %}

<section class="product-page product-page--full" data-product-page>
  <div class="product-layout product-layout--gallery">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__main" data-gallery-main aria-live="polite">{% if initial_media %}{{ initial_media.preview_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', alt: product_alt }}{% else %}<img src="{{ 'auralis-extractor-hero.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="800" height="800" loading="eager">{% endif %}</div>
      {% if product.media.size > 1 %}<div class="product-gallery__thumbs" aria-label="Product gallery">{% for media in product.media limit: 8 %}{% if media.media_type == 'image' %}<button type="button" class="gallery-thumb{% if media.id == initial_media.id %} is-active{% endif %}" data-gallery-thumb data-media-id="{{ media.id }}" data-full-image="{{ media.preview_image | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if media.id == initial_media.id %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</button>{% endif %}{% endfor %}</div>{% endif %}
    </div>
    <div class="product-copy product-copy--purchase"><p class="auralis-kicker">Monovere countertop extractor</p><h1>{{ product.title }}</h1><p class="product-price product-price--large" data-product-price>{{ selected_variant.price | money }}</p><p class="product-fact-line">USB-C powered / 3 speeds / 180 x 108 x 420 mm</p><div class="rte">{{ product.description }}</div>
      {% form 'product', product, class: 'product-form product-form--full', id: 'product-form' %}
        {% unless product.has_only_default_variant %}<fieldset class="product-finish"><legend>Finish <span data-selected-finish>{{ selected_variant.title }}</span></legend><div>{% for variant in product.variants %}<button class="product-finish__button{% if variant.id == selected_variant.id %} is-active{% endif %}" type="button" data-product-variant-picker data-variant-id="{{ variant.id }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" aria-pressed="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>{% endfor %}</div></fieldset><select id="product-variant" class="product-native-variant" name="id" aria-label="Finish">{% for variant in product.variants %}<option value="{{ variant.id }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" {% if variant.id == selected_variant.id %}selected{% endif %}{% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ selected_variant.id }}">{% endunless %}
        <label for="product-quantity">Quantity</label><div class="quantity-row"><input id="product-quantity" name="quantity" type="number" min="1" value="1" inputmode="numeric" autocomplete="off"><button class="button" type="submit" data-product-submit {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}Add to bag{% else %}Sold out{% endif %}</button></div>
        {% if section.settings.show_dynamic_checkout %}<div class="dynamic-payment">{{ form | payment_button }}</div>{% endif %}
      {% endform %}
      <div class="purchase-notes"><span>Requires continuous power while in use</span><span>Shipping options and enabled payment methods appear at checkout</span></div>
    </div>
  </div>
</section>

<section class="product-accordions section"><div class="section-heading"><p class="eyebrow">Product information</p><h2>Everything you should know first.</h2></div><div class="faq-list"><details open><summary>How it works<span aria-hidden="true">+</span></summary><div class="faq-answer">Place the black front intake beside the cooking source. It is designed to draw smoke toward the device, not blow air toward the pan.</div></details><details><summary>What is included<span aria-hidden="true">+</span></summary><div class="faq-answer">Extractor, tripod, filter screen, USB-C cable and instruction manual.</div></details><details><summary>Power and ventilation<span aria-hidden="true">+</span></summary><div class="faq-answer">This model needs continuous USB-C power while in use. Use it alongside normal kitchen ventilation; it does not replace a range hood.</div></details><details><summary>Delivery and payment<span aria-hidden="true">+</span></summary><div class="faq-answer">Shipping options and payment methods enabled for this store are calculated and confirmed securely at checkout.</div></details></div></section>

{% schema %}
{"name":"Main product","settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout buttons","default":true}],"presets":[{"name":"Main product"}]}
{% endschema %}
