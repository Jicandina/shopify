<section class="cart-page">
  <div class="section-heading"><p class="eyebrow">Your selection</p><h1>Bag</h1><p>Shipping and taxes are calculated securely at checkout.</p></div>
  {% if cart.item_count == 0 %}<div class="cart-empty"><p>Your bag is empty.</p><a class="button" href="{{ routes.root_url }}#buy">Shop the extractor</a></div>
  {% else %}{% form 'cart', cart, class: 'cart-form' %}<div class="cart-items">{% for item in cart.items %}<article class="cart-item"><a class="cart-item__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><p>{{ item.variant.title }}</p><a href="{{ item.url_to_remove }}">Remove</a></div><label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><div class="cart-summary"><div><p class="eyebrow">Subtotal</p><h2>{{ cart.total_price | money }}</h2><p>Final delivery choices are shown at checkout.</p></div><div class="cart-actions"><button class="button button--quiet" type="submit" name="update">Update bag</button><button class="button" type="submit" name="checkout">Secure checkout</button></div></div>{% endform %}{% endif %}
</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
